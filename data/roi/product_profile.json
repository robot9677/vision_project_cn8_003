{
  "product_name": "vision_inspection_basic",
  "recipe_name": "presence_basic",
  "enable_modules": {
    "enhance": true,
    "measure": true,
    "locate": true,
    "identify": false,
    "__comment": "auto_inspect : true 는 자동 검사 장비를 의미",
