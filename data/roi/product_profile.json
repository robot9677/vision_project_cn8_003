    "min_score": 0.83,
    "grace_frames": 8,
    "fallback_mode": "fixed_roi",
    "smooth": {
      "max_step_x": 18,
      "max_step_y": 18
    },
    "anchors": [
      {
        "id": "anchor_main",
        "roi_id": 1,
        "targets": "all",

        "search_margin_x": 80,
        "search_margin_y": 120,

        "enable_rotation": false,

        "wide_reacquire_margin_x": 240,
        "wide_reacquire_margin_y": 360
      }
    ]
  }
