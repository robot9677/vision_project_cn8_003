{
  "enabled": true,
  "backend": "modbus_rtu_slave",

  "serial": {
    "port": "/dev/ttyUSB1",
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout": 1
  },

  "modbus": {
    "slave_id": 1
  },

  "registers": {
    "command": 199,
    "status": 200,
    "result": 201
  }
}