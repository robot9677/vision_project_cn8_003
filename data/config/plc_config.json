{
  "enabled": true,
  "backend": "modbus_rtu_slave",
  "serial": {
    "port": "/dev/ttyUSB1",
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout": 1,
    "reconnect_interval_sec": 1.0
  },
  "modbus": {
    "slave_id": 1
  },
  "registers": {
    "command": 200,
    "status": 201,
    "result": 202,
    "heartbeat": 203
  },
  "heartbeat": {
    "interval_sec": 0.5,
    "max_value": 9999
  },
  "shutdown": {
    "command": "sudo /sbin/shutdown -h now",
    "ready_hold_sec": 2.0
  },
  "recovery": {
    "camera_open_timeout_sec": 2.0,
    "camera_retry_interval_sec": 0.1,
    "camera_grace_sec": 2.0,
    "frame_timeout_sec": 1.0
  },
  "live_trace": {
    "enabled": true,
    "path": "data/logs/plc_live.jsonl",
    "max_bytes": 5242880,
    "keep_files": 2,
    "include_state_changes": true,
    "include_heartbeat": true
  },
  "error_test": {
    "enabled": true,
    "request_path": "data/runtime/plc_error_test_request.json",
    "delete_after_read": true,
    "allowed_types": [
      "camera",
      "light",
      "inspection",
      "plc_comm"
    ],
    "safe_logical_mode": true,
    "allow_hardware_fault_tests": false
  },
  "service_panel": {
    "enabled": true,
    "panel_width": 560,
    "opacity": 0.96,
    "password_sha256": "e9036ed9fdef51f99f8cd34a7023152d9bc93211e15511133721fae725fb7bfe",
    "lock_on_close": true,
    "show_roi_debug": true,
    "rx_tx_rows": 4
  }
}