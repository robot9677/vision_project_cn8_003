{
  "enabled": true,
  "backend": "modbus_rtu_slave",
  "serial": {
    "port": "/dev/ttyUSB1",
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout": 1,
    "reconnect_interval_sec": 1.0
  },
  "modbus": {
    "slave_id": 1
  },
  "registers": {
    "command": 200,
    "status": 201,
    "result": 202,
    "heartbeat": 203
  },
  "heartbeat": {
    "interval_sec": 0.5,
    "max_value": 9999
  },
  "shutdown": {
    "command": "sudo /sbin/shutdown -h now",
    "ready_hold_sec": 2.0
  },
  "recovery": {
    "camera_open_timeout_sec": 2.0,
    "camera_retry_interval_sec": 0.1,
    "camera_grace_sec": 2.0,
    "frame_timeout_sec": 1.0
  }
}
