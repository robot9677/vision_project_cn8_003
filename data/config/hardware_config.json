{
  "active_camera_set": "b0429_single",
  "active_light_set": "jk_10v_single",

  "camera_sets": {
    "b0429_single": {
      "mode": "single",
      "backend": "gstreamer",
      "cameras": [
        {
          "id": "cam1",
          "name": "B0429_AR0234",
          "device": "/dev/video0",
          "width": 1920,
          "height": 1200,
          "fps": 30,
          "pipeline_type": "b0429_gray16_to_gray8",
          "input_format": "GRAY16_LE",
          "output_format": "GRAY8",
          "camera_profile": "default"
        }
      ]
    }
  },

  "light_sets": {
    "jk_10v_single": {
      "backend": "jk_10v_modbus",
      "port": "/dev/ttyUSB0",
      "slave_id": 1,
      "baudrate": 9600,
      "timeout": 0.5,
      "register": 10,
      "min_percent": 0,
      "max_percent": 100,
      "default_brightness": 20,
      "shutdown_to_zero": false,

      "spot_inspect": {
        "enabled": true,
        "light_id": "light1",

        "idle_brightness": 20,
        "inspect_brightness": 90,

        "ramp_enabled": true,
        "ramp_steps": [20, 60, 90],
        "ramp_step_ms": 80,

        "pre_ready_settle_ms": 200,
        "pre_ready_flush_frames": 4,

        "inspect_settle_ms": 20,
        "inspect_flush_frames": 1,

        "armed_timeout_ms": 2000,
        "restore_after_inspect": true
      },
    
      "lights": [
        {
          "id": "light1",
          "camera_id": "cam1",
          "brightness": 20
        }
      ]
    },

    "mock_single": {
      "backend": "mock",
      "lights": [
        {
          "id": "light1",
          "camera_id": "cam1",
          "brightness": 70
        }
      ]
    }
  }
}